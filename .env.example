# ==============================================================================
# Copie para .env e preencha. O .env está no .gitignore: NUNCA o commite.
# ==============================================================================

# Modo de desenvolvimento. Em produção deixe False (padrão).
# Com False, a API se recusa a iniciar sem API_AUTH_KEY.
FLASK_DEBUG=True

# Chave do Google Gemini — obtenha em https://aistudio.google.com/
GEMINI_API_KEY=SUA_CHAVE_DE_API_AQUI

# Chave que os clientes enviam no cabeçalho X-API-KEY.
# Obrigatória em produção. Gere uma com: python -c "import secrets; print(secrets.token_hex(16))"
# O backend do HIPERTROF.IA usa o mesmo valor em TREINO_API_KEY.
API_AUTH_KEY=

# Banco de dados. Vazio = SQLite local (api_academia.db).
# Neon: postgresql://USUARIO:SENHA@HOST.neon.tech/neondb?sslmode=require
# DATABASE_URL=

# Origens de navegador liberadas no CORS, separadas por vírgula.
# Vazio (padrão) = nenhuma: esta API é chamada de servidor para servidor.
ALLOWED_ORIGINS=
